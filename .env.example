# An OpenAI-compatible API with native tool calling and image input.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-vision-language-model
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=12000

# Optional: providers that require max_completion_tokens or reject temperature.
# OPENAI_MAX_TOKENS_PARAM=max_completion_tokens
# OPENAI_SEND_TEMPERATURE=false

# Optional NCBI contact details for literature retrieval.
# NCBI_EMAIL=you@example.org
# NCBI_API_KEY=

# Optional image-tool model; otherwise use OPENAI_MODEL.
# MEDCASE_VISION_MODEL=your-vision-language-model
# Optional specialized medical-image endpoint (OpenAI-compatible).
# MEDCASE_MEDGEMMA_MODEL=your-served-medgemma-model
# MEDCASE_MEDGEMMA_BASE_URL=https://your-medical-model-provider.example/v1

# Optional alternate disease index (the bundled index is used by default).
# MEDCASE_DISEASE_INDEX=/path/to/disease_index.jsonl.gz
